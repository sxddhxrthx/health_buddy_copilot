# Same-origin /api by default. For packaged native apps set an HTTPS API origin.
# VITE_API_BASE_URL=https://your-research-twin.example
# Server: comma-separated explicit browser/native origins (no wildcard).
# ALLOWED_ORIGINS=https://localhost,capacitor://localhost
# PORT=3001
# Server variables are not loaded from this file automatically.
# APP_ORIGIN=http://localhost:5173
# RESEARCH_TWIN_DATA_DIR=.local
# HOST=127.0.0.1
# Compose port override (also sets the matching APP_ORIGIN):
# DEMO_PORT=8080